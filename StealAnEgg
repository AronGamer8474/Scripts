-- ===== Safe GUI parent selector =====
local function getGuiParent()
    -- 1. Executor hidden UI
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui, "gethui" end
    end
    -- 2. CoreGui — test write access first
    local coreOk, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if coreOk and coreGui then
        local test = Instance.new("Folder")
        local writeOk = pcall(function() test.Parent = coreGui end)
        if writeOk and test.Parent == coreGui then
            test:Destroy()
            return coreGui, "CoreGui"
        end
        pcall(function() test:Destroy() end)
    end
    -- 3. PlayerGui fallback
    local pg = LP and LP:WaitForChild("PlayerGui", 10)
    if pg then return pg, "PlayerGui" end
    return nil, "none"
end

