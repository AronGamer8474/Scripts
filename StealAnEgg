    C.Min.MouseButton1Click:Connect(function() C.Main.Visible = false; C.Bubble.Visible = true end)
    C.Bubble.MouseButton1Click:Connect(function() C.Main.Visible = true; C.Bubble.Visible = false end)
    C.Bubble.MouseButton2Click:Connect(function() S.running = false; C.SG:Destroy() end)

    -- ===== Toggle builder =====
    local order = { Farm = 0, Eggs = 0, Progress = 0, Character = 0 }

    local function addToggle(pageKey, label, def, key)
        order[pageKey] = order[pageKey] + 1
        local page = pages[pageKey]

        local row = Instance.new("Frame")
        local lbl = Instance.new("TextLabel")
        local btn = Instance.new("TextButton")
        local corner = Instance.new("UICorner")

        row.Name = "Row_" .. key
        row.Size = UDim2.new(1,-6,0,28)
        row.BackgroundTransparency = 1
        row.LayoutOrder = order[pageKey]

        lbl.Size = UDim2.new(1,-52,1,0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = T.Text
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        btn.Size = UDim2.new(0,44,0,18)
        btn.Position = UDim2.new(1,-48,0.5,-9)
        btn.BackgroundColor3 = def and T.Accent or T.Off
        btn.Text = def and "ON" or "OFF"
        btn.TextColor3 = def and Color3.new(0,0,0) or T.Dim
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false

        corner.CornerRadius = UDim.new(0,4)

        corner.Parent = btn
        lbl.Parent = row
        btn.Parent = row
        row.Parent = page

        local on = def
        btn.MouseButton1Click:Connect(function()
            on = not on
            btn.BackgroundColor3 = on and T.Accent or T.Off
            btn.Text = on and "ON" or "OFF"
            btn.TextColor3 = on and Color3.new(0,0,0) or T.Dim
            S[key] = on
        end)
    end

    -- ===== Slider builder =====
    local function addSlider(pageKey, label, minV, maxV, def, key, suffix)
        order[pageKey] = order[pageKey] + 1
        local page = pages[pageKey]

        local row = Instance.new("Frame")
        local lbl = Instance.new("TextLabel")
        local box = Instance.new("TextBox")
        local corner = Instance.new("UICorner")

        row.Name = "Slider_" .. key
        row.Size = UDim2.new(1,-6,0,28)
        row.BackgroundTransparency = 1
        row.LayoutOrder = order[pageKey]

        lbl.Size = UDim2.new(1,-82,1,0)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = T.Text
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        box.Size = UDim2.new(0,74,0,20)
        box.Position = UDim2.new(1,-78,0.5,-10)
        box.BackgroundColor3 = T.Off
        box.Text = tostring(def) .. (suffix or "")
        box.TextColor3 = T.Text
        box.Font = Enum.Font.GothamBold
        box.TextSize = 11
        box.BorderSizePixel = 0
        box.ClearTextOnFocus = false

        corner.CornerRadius = UDim.new(0,4)

        corner.Parent = box
        lbl.Parent = row
        box.Parent = row
        row.Parent = page

        box.FocusLost:Connect(function()
            local num = tonumber(box.Text:match("-?%d+%.?%d*"))
            if num then
                num = math.clamp(num, minV, maxV)
                S[key] = num
                box.Text = tostring(num) .. (suffix or "")
            else
                box.Text = tostring(S[key]) .. (suffix or "")
            end
        end)
    end

    -- ===== FARM =====
