    -- ===== Implementations =====
    local function getHum()
        local char = LP.Character
        return char and char:FindFirstChildOfClass("Humanoid"), char
    end

    RunService.RenderStepped:Connect(function()
        if not S.running or not S.speedOn then return end
        local hum = getHum()
        if hum and hum.WalkSpeed ~= S.walkSpeed then
            hum.WalkSpeed = S.walkSpeed
        end
    end)

    UIS.JumpRequest:Connect(function()
        if not S.running or not S.infJump then return end
        local hum = getHum()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end)

    RunService.Stepped:Connect(function()
        if not S.running or not S.noclip then return end
        local _, char = getHum()
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        if not S.running or not S.fly then return end
        local hum, char = getHum()
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local cam = workspace.CurrentCamera
        if not (hum and root and cam) then return end
        hum.PlatformStand = true
        local dir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        root.AssemblyLinearVelocity = Vector3.zero
        if dir.Magnitude > 0 then
            root.CFrame = root.CFrame + dir.Unit * S.flySpeed * dt
        end
    end)

    LP.Idled:Connect(function()
        if not S.running or not S.antiAfk then return end
        pcall(function()
            VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            task.wait(0.1)
            VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        end)
    end)

    -- Remote discovery
    local Remotes = {}
    local function findRemote(name)
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) and string.find(d.Name, name, 1, true) then
                return d
            end
        end
        return nil
    end
    Remotes.Carry        = findRemote("AskFieldEggCarry")
    Remotes.Place        = findRemote("AskPlaceEgg")
    Remotes.Snapshot     = findRemote("AskFieldEggSnapshot")
    Remotes.EquipBest    = findRemote("WearBest") or findRemote("EQUIP_BEST")
    Remotes.SellAsset    = findRemote("SellPet") or findRemote("SELL_ASSET")
    Remotes.BaseUpgrade  = findRemote("AskBaseTierRaise") or findRemote("BaseUpgrade")
    Remotes.TreadmillUp  = findRemote("AskTierRaise")
    Remotes.TreadmillOn  = findRemote("AskWearStill")
    Remotes.TreadmillOff = findRemote("AskDoff")
    Remotes.ClaimIndex   = findRemote("AskRedeemAll")
    Remotes.FuseReveal   = findRemote("FinishReveal")
    Remotes.FuseAck      = findRemote("ConfirmBriefing")
    Remotes.FuseLoad     = findRemote("LoadPet")
    Remotes.FuseStart    = findRemote("BeginFuse")
    Remotes.TrailBuy     = findRemote("AskPurchase")
    Remotes.TrailWear    = findRemote("AskChoose")
    Remotes.OfflineGet   = findRemote("FetchSummary")
    Remotes.OfflineClaim = findRemote("AskCollect")
    Remotes.GroupReward  = findRemote("RedeemPerk")

    local function fire(remote, ...)
        if not remote then return end
        if remote:IsA("RemoteEvent") then
            pcall(function() remote:FireServer(...) end)
        elseif remote:IsA("RemoteFunction") then
            pcall(function() remote:InvokeServer(...) end)
        end
    end

    task.spawn(function()
        while S.running do
            task.wait(0.5)
            if S.autofarm and Remotes.Snapshot then fire(Remotes.Snapshot) end
        end
    end)

    task.spawn(function()
        while S.running do
            task.wait(1)
            if S.autoEquipBest and Remotes.EquipBest then fire(Remotes.EquipBest) end
        end
    end)

    task.spawn(function()
        while S.running do
            task.wait(5)
            if S.autoClaimIndex and Remotes.ClaimIndex then fire(Remotes.ClaimIndex) end
            if S.claimOffline and Remotes.OfflineGet and Remotes.OfflineClaim then
                local summary = nil
                pcall(function() summary = Remotes.OfflineGet:InvokeServer() end)
                if type(summary) == "table" and (tonumber(summary.ClaimableAmount) or 0) > 0 then
                    fire(Remotes.OfflineClaim)
                end
            end
            if S.autoUpgrade and Remotes.BaseUpgrade then fire(Remotes.BaseUpgrade) end
        end
    end)

    G.__SANTOS_SHUTDOWN = function()
        S.running = false
        pcall(function() C.SG:Destroy() end)
        G.__SANTOS_SHUTDOWN = nil
    end

    tab("Farm")

    return parentName
end, function(err)
    return tostring(err)
end)

-- ===== Result =====
if buildOk then
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Santos Hub",
            Text = "Loaded. Parent: " .. tostring(buildErr),
            Duration = 3
        })
    end)
    print("[Santos Hub] Loaded. Parent: " .. tostring(buildErr))
else
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Santos Hub — Error",
            Text = tostring(buildErr),
            Duration = 10
        })
    end)
    warn("[Santos Hub] Build failed: " .. tostring(buildErr))
end
